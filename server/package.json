{
  "name": "@capsule/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "razorpay:health": "curl -s -o /dev/null -w \"%{http_code}\" https://api.razorpay.com/v1/",
    "agent:unit": "tsx --test agent/*.unit.test.ts",
    "agent:test": "tsx agent/test.ts",
    "linear:dry-run": "tsx agent/linear-test.ts",
    "linear:real": "tsx agent/linear-test.ts --real",
    "linear:login": "tsx agent/linear-login.ts"
  },
  "dependencies": {
    "@google/genai": "^2.20.0",
    "@simplewebauthn/server": "^14.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
